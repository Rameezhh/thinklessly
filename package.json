{
  "name": "thinklessly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker,live -c cyan,magenta,yellow \"pnpm dev:web\" \"pnpm dev:worker\" \"pnpm dev:live\"",
    "dev:web": "next dev",
    "dev:worker": "tsx watch worker/index.ts",
    "dev:live": "tsx watch live/wisp-server.ts",
    "build": "next build",
    "start": "next start",
    "build:live": "tsx scripts/build-live.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ensure:data": "node -e \"require('fs').mkdirSync('data',{recursive:true})\"",
    "predev": "pnpm ensure:data && pnpm build:live",
    "prebuild": "pnpm build:live",
    "seed": "tsx prisma/seed.ts",
    "gen:key": "tsx scripts/gen-key.ts",
    "adblock:fetch": "tsx scripts/fetch-adblock-lists.ts",
    "smoke": "tsx scripts/smoke-runner.ts && tsx scripts/smoke-obstructions.ts",
    "run-file": "tsx worker/run-file.ts",
    "enqueue-test": "tsx scripts/enqueue-test.ts",
    "sim:tls": "node scripts/local-tls.mjs",
    "sim:build": "pnpm build:live && node scripts/sim-build.mjs",
    "sim:web": "next start -p 3010",
    "sim:worker": "tsx worker/index.ts",
    "sim:wisp": "tsx live/wisp-server.ts",
    "sim:proxy": "node scripts/local-proxy.mjs",
    "sim:start": "concurrently -k -n web,worker,wisp,proxy -c cyan,magenta,yellow,green \"pnpm sim:web\" \"pnpm sim:worker\" \"pnpm sim:wisp\" \"pnpm sim:proxy\"",
    "sim:setup": "pnpm ensure:data && pnpm sim:tls && pnpm db:generate && prisma migrate deploy",
    "sim": "pnpm sim:setup && pnpm sim:build && pnpm sim:start",
    "db:migrate": "pnpm ensure:data && prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "^2.20.3",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "1.5.2",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@mercuryworkshop/wisp-js": "0.5.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "croner": "^11.0.0",
    "dotenv": "^18.0.9",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.67.0",
    "next": "16.4.3",
    "playwright": "^1.64.1",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
